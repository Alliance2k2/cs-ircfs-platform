# Copy to stack.env (never commit stack.env) and replace every value marked change-me.
POSTGRES_PASSWORD=change-me-long-random-password
# One or more "secret:role" pairs for integrations and the first administrator session.
API_KEY_ROLES=change-me-random-secret:administrator
PLATFORM_PORT=8000
# Leave empty: the dashboard is served by the platform itself (same origin).
CORS_ORIGINS=
# Africa's Talking callback secret: https://<host>/api/v1/ussd?token=<value> (at least 24 characters).
GATEWAY_CALLBACK_TOKEN=change-me-long-random-callback-secret
# Optional comma-separated allow-list of the provider's callback IP addresses.
GATEWAY_ALLOWED_IPS=

# Field channels. Leave dry_run until Africa's Talking credentials and a short code are approved.
SMS_PROVIDER=dry_run
AIRTIME_PROVIDER=dry_run
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
# Leave empty until Africa's Talking approves a sender ID (always empty in the sandbox).
SMS_SENDER_ID=

# Optional: Google sign-in OAuth client ID.
GOOGLE_CLIENT_ID=

# Optional: public Mapbox token (pk.…) for the dashboard map.
MAPBOX_ACCESS_TOKEN=

# Delivery and policy-controlled privacy operations. Queue dispatch is opt-in.
DELIVERY_MAX_AGE_HOURS=24
AUDIT_PERSONAL_READS=true
MESSAGE_RETENTION_DAYS=30
FIELD_USER_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=365
# Keep private routing off until the district approves its policy and key management.
ANONYMOUS_REPLY_QUEUE_ENABLED=false
ANONYMOUS_REPLY_ENCRYPTION_KEY=
ANONYMOUS_REPLY_POLICY_REFERENCE=
ANONYMOUS_REPLY_TTL_SECONDS=300
