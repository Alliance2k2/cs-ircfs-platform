# Copy to stack.env (never commit stack.env) and replace every value marked change-me.
POSTGRES_PASSWORD=change-me-long-random-password
# One or more "secret:role" pairs for integrations and the first administrator session.
API_KEY_ROLES=change-me-random-secret:administrator
PLATFORM_PORT=8000
CORS_ORIGINS=http://localhost:8000

# Field channels. Leave dry_run until Africa's Talking credentials and a short code are approved.
SMS_PROVIDER=dry_run
AIRTIME_PROVIDER=dry_run
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
SMS_SENDER_ID=CS-IRCFS

# Optional: Google sign-in OAuth client ID.
GOOGLE_CLIENT_ID=
