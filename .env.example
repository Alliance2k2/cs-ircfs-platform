# Copy to .env for local development. Never commit real credentials.
APP_NAME=CS-IRCFS Platform API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./cs_ircfs.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
# For pilot/production use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://cs_ircfs:change-me@localhost:5432/cs_ircfs
# REQUIRE_API_KEY=true
# API_KEY_ROLES=replace-with-planner-key:district_planner,replace-with-admin-key:administrator
# ENVIRONMENT=production refuses to start unless REQUIRE_API_KEY=true, DATABASE_URL is
# PostgreSQL, COOKIE_SECURE=true, CORS_ORIGINS has no localhost entry (leave it empty when
# the dashboard is served by this API) and GATEWAY_CALLBACK_TOKEN is set.
# To run against a local PostgreSQL with real sign-in, use ENVIRONMENT=staging instead.

# Sign-in sessions last this many hours.
SESSION_HOURS=12
# false for local HTTP development; true (HTTPS) in every deployed environment.
COOKIE_SECURE=false
# Optional Google sign-in (OAuth client ID). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Field channels (see ussd-sms/README.md). dry_run records messages without sending them.
# Shared secret appended to the Africa's Talking callback URLs, e.g.
#   https://<host>/api/v1/ussd?token=<value>   (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Required in production. GATEWAY_ALLOWED_IPS optionally limits callbacks to the provider's addresses.
GATEWAY_CALLBACK_TOKEN=
GATEWAY_ALLOWED_IPS=
SMS_PROVIDER=dry_run
AIRTIME_PROVIDER=dry_run
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
# Leave empty until Africa's Talking approves a sender ID (always empty in the sandbox).
SMS_SENDER_ID=
INCENTIVE_AMOUNT_RWF=100
INCENTIVE_EVERY_N_REPORTS=3
# Report types that count towards a reward: rainfall, infrastructure, nutrition (comma-separated).
INCENTIVE_REPORT_TYPES=rainfall,infrastructure,nutrition
# At most this many rewarded nutrition surveys per household per calendar month (0 disables).
INCENTIVE_NUTRITION_PER_MONTH=1

# Irrigation Scheduling Assistant: 7-day rainfall thresholds in mm (calibrate with PADAB/APEFA records).
DRY_SPELL_THRESHOLD_MM=10
WET_SPELL_THRESHOLD_MM=40

# Staff alerts: SMS these district phones when a case opens (comma-separated, e.g. +250788123456,+250788654321).
# ALERT_MIN_PRIORITY is "critical" (offline assets, severity-5 pests) or "high" (also faulty assets, severity 4).
ALERT_PHONE_NUMBERS=
ALERT_MIN_PRIORITY=critical

# Add the Open-Meteo 7-day rain forecast to irrigation advice (free, needs internet).
WEATHER_FORECAST_ENABLED=true

# Weekly automatic irrigation advice (also available as scripts/send_weekly_advice.py).
# Off by default: the manual Send advice button always works either way.
ADVICE_SCHEDULE_ENABLED=false
ADVICE_SCHEDULE_WEEKDAY=mon
ADVICE_SCHEDULE_TIME=06:00

# Cooperative pilot (Section 8): progress bar towards trained Citizen Science Monitors,
# and how many cooperatives are in the Data Champion pilot.
MONITOR_TRAINING_TARGET=200
PILOT_COOPERATIVE_TARGET=3

# Recurring-bottleneck rule (Section 9.3): flag a category on a scheme when it reaches
# MIN_COUNT reports within WINDOW_DAYS. MIN_SHARE (0-1) additionally requires the
# category to hold that share of the scheme's reports; 0 disables the share check.
# CATEGORY_MIN_COUNTS overrides single categories, e.g. technical:4,social:2.
# Per-sector rainfall thresholds and AfDB baselines are imported by the scripts in
# backend/scripts/ and override/ground these defaults.
BOTTLENECK_WINDOW_DAYS=90
BOTTLENECK_MIN_COUNT=3
BOTTLENECK_MIN_SHARE=0
BOTTLENECK_CATEGORY_MIN_COUNTS=
