# Copy to .env for local development. Never commit real credentials.
APP_NAME=CS-IRCFS Platform API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./cs_ircfs.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
# For pilot/production use PostgreSQL, for example:
# DATABASE_URL=postgresql+psycopg://cs_ircfs:change-me@localhost:5432/cs_ircfs
# REQUIRE_API_KEY=true
# API_KEY_ROLES=replace-with-planner-key:district_planner,replace-with-admin-key:administrator

# Sign-in sessions last this many hours.
SESSION_HOURS=12
# Optional Google sign-in (OAuth client ID). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Field channels (see ussd-sms/README.md). dry_run records messages without sending them.
SMS_PROVIDER=dry_run
AIRTIME_PROVIDER=dry_run
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=
SMS_SENDER_ID=CS-IRCFS
INCENTIVE_AMOUNT_RWF=100
INCENTIVE_EVERY_N_REPORTS=3

# Irrigation Scheduling Assistant: 7-day rainfall thresholds in mm (calibrate with PADAB/APEFA records).
DRY_SPELL_THRESHOLD_MM=10
WET_SPELL_THRESHOLD_MM=40
